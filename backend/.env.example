METABASE_URL=https://metabase.wiom.in
METABASE_API_KEY=
METABASE_DATABASE_ID=113
INVENTORY_SCHEMA=PROD_DB.DBT_INVENTORY_REQUEST
QUERY_CACHE_TTL_SECONDS=300
CORS_ORIGINS=["http://localhost:3000"]

# First-admin login, seeded only if backend/app/data/users.json doesn't
# exist yet. Set this explicitly in every deploy environment - if left
# unset, a random password is generated and printed once to the server log
# at startup (search the log for "ADMIN_SEED_PASSWORD").
ADMIN_SEED_EMAIL=admin@wiom.in
ADMIN_SEED_PASSWORD=
